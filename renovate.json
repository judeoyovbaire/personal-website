{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    ":maintainLockFilesWeekly"
  ],
  "labels": ["dependencies"],
  "timezone": "Europe/London",
  "schedule": ["before 8am on Monday"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "dependencyDashboard": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "minimumReleaseAge": null,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Next.js and its ESLint config must move together.",
      "matchPackageNames": ["next", "eslint-config-next", "@next/*"],
      "groupName": "next"
    },
    {
      "description": "React runtime and types move together.",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react"
    },
    {
      "description": "typescript-eslint (via eslint-config-next) rejects the TypeScript 7 API, so lint fails on TS 7. Hold until https://github.com/typescript-eslint/typescript-eslint/issues/10940 lands.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
